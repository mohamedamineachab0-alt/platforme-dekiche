datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

enum Role {
  STUDENT
  PARENT
  TEACHER
  ADMIN
}

enum Wilaya {
  W01
  W02
  W03
  W04
  W05
  W06
  W07
  W08
  W09
  W10
  W11
  W12
  W13
  W14
  W15
  W16
  W17
  W18
  W19
  W20
  W21
  W22
  W23
  W24
  W25
  W26
  W27
  W28
  W29
  W30
  W31
  W32
  W33
  W34
  W35
  W36
  W37
  W38
  W39
  W40
  W41
  W42
  W43
  W44
  W45
  W46
  W47
  W48
  W49
  W50
  W51
  W52
  W53
  W54
  W55
  W56
  W57
  W58
}

enum Level {
  AS1
  AS2
  AS3
  AP1
  AP2
  AP3
  AP4
  AP5
  AM1
  AM2
  AM3
  AM4
  ENG_BEGINNER
  ENG_INTERMEDIATE
  ENG_ADVANCED
  FR_BEGINNER
  FR_INTERMEDIATE
  FR_ADVANCED
  ES_BEGINNER
  ES_INTERMEDIATE
  ES_ADVANCED
  LANG_BEGINNER
  LANG_INTERMEDIATE
  LANG_ADVANCED
  SOR_BEGINNER
  SOR_INTERMEDIATE
  SOR_ADVANCED
  QUR_BEGINNER
  QUR_INTERMEDIATE
  QUR_ADVANCED
  ISL_BEGINNER
  ISL_INTERMEDIATE
  ISL_ADVANCED
  TR_BEGINNER
  TR_INTERMEDIATE
  TR_ADVANCED
}

enum Stream {
  SCIENCES
  MATH
  TECH_MATH
  GESTION
  LETTRES
  LANGUAGES
  COMMON_TRUNK
  ALL
  ENGLISH
  FRENCH
  SPANISH
  MIDDLE_SCIENCE
  MIDDLE_LETTERS
  SOROBAN
  QURAN
  ISLAMIC
  PRIMARY
  COMPUTER
  ACCOUNTING
  OFFICE
  PROGRAMMING
  ROBOTICS
  ART
  DESIGN
  VIDEO
  CHESS
  MUSIC
  CALLIGRAPHY
  THEATER
}

enum UnderstandingLevel {
  FAST
  AVERAGE
  WEAK
}

enum PlatformBranch {
  STUDY
  SMART_TEACHER
  LANGUAGES
  SOROBAN
  QURAN
  ISLAMIC
  TRAINING
}

enum PracticeKind {
  SELF_TEST
  MOCK_EXAM
  DAILY_CHALLENGE
  BANK
}

enum PracticeDifficulty {
  EASY
  MEDIUM
  HARD
  CHALLENGE
}

model User {
  id                   String                @id @default(cuid())
  fullName             String
  phoneNumber          String                @unique
  passwordHash         String                @default("")
  avatarUrl            String?
  role                 Role
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  studentProfile       StudentProfile?
  parentProfile        ParentProfile?
  teacherProfile       Teacher?
  parentLinks          ParentStudentLink[]   @relation("ParentLink")
  studentLinks         ParentStudentLink[]   @relation("StudentLink")
  lastLoginAt          DateTime              @default(now())
  deviceFingerprints   String[]              @default([])
  failedLoginAttempts  Int                   @default(0)
  lockedUntil          DateTime?
  accessCodes          AccessCode[]
  mistakes             StudentMistake[]
  submissions          StudentSubmission[]   @relation("StudentSubmissions")
  enrollments          Enrollment[]          @relation("StudentEnrollments")
  chatSessions         ChatSession[]
  parentTickets        ParentTicket[]
  forumMessages        ForumMessage[]
  friendLinksSource    StudentFriendLink[]   @relation("StudentLinkSource")
  friendLinksTarget    StudentFriendLink[]   @relation("StudentLinkTarget")
  subscriptionRequests SubscriptionRequest[]
  lessonOpinions       LessonOpinion[]
  practiceAttempts     PracticeAttempt[]
  daliliProfile        DaliliProfile?
  watchHistories       WatchHistory[]
  courseProgress       CourseProgress[]
  quizAttempts         QuizAttempt[]
}

model StudentProfile {
  id                 String              @id @default(cuid())
  userId             String              @unique
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentName         String
  parentPhone        String
  level              Level
  stream             Stream
  wilaya             Wilaya
  branch             PlatformBranch      @default(STUDY)
  understandingLevel UnderstandingLevel?
  totalPoints        Int                 @default(0)
  parentCode         String?             @unique @default(cuid())
  friendCode         String?             @unique @default(cuid())
}

model ParentProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Teacher {
  id        String    @id @default(cuid())
  userId    String?   @unique
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  phone     String    @unique
  levels    Level[]
  streams   Stream[]
  subjects  Subject[]
  createdAt DateTime  @default(now())
}

model Subject {
  id                      String            @id @default(uuid())
  title                   String
  description             String
  teacherName             String
  teacherId               String?
  teacher                 Teacher?          @relation(fields: [teacherId], references: [id])
  level                   Level
  stream                  Stream
  levels                  Level[]           @default([])
  streams                 Stream[]          @default([])
  image                   String // Square image URL from Supabase Storage
  price                   Float
  accessType              String // 'MONTHLY' or 'YEARLY'
  isPublished             Boolean           @default(false)
  lessons                 Lesson[] // One-to-many relation
  liveClasses             LiveClass[] // One-to-many relation
  codes                   AccessCode[] // One-to-many relation
  enrollments             Enrollment[]
  dailyExercises          DailyExercise[]   @relation("PrimarySubject")
  secondaryDailyExercises DailyExercise[]   @relation("SecondarySubject")
  exams                   Exam[]            @relation("ExamSubject")
  secondaryExams          Exam[]            @relation("ExamSecondarySubject")
  reviewCards             ReviewCard[]
  classForums             ClassForum[]
  practiceAttempts        PracticeAttempt[]
  watchHistories          WatchHistory[]
  courseProgress          CourseProgress[]
  quizAttempts            QuizAttempt[]
  createdAt               DateTime          @default(now())
}

model Lesson {
  id             String           @id @default(uuid())
  title          String
  month          Int // e.g., 1, 2, 3
  vimeoVideoId   String // Vimeo video ID
  image          String? // Square image URL for the lesson from Supabase Storage
  description    String?          @db.Text
  subjectId      String
  subject        Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectIds     String[]         @default([])
  streams        Stream[]         @default([])
  levels         Level[]          @default([])
  isPublished    Boolean          @default(true)
  quiz           Quiz? // One-to-one relation with AI Quiz
  mistakes       StudentMistake[]
  materials      LessonMaterial[]
  opinions       LessonOpinion[]
  watchHistories WatchHistory[]
  courseProgress CourseProgress[]
  createdAt      DateTime         @default(now())
}

model LessonMaterial {
  id        String   @id @default(uuid())
  title     String
  fileUrl   String
  fileType  String?
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([lessonId])
}

model LessonOpinion {
  id        String   @id @default(cuid())
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, lessonId])
  @@index([lessonId])
  @@index([createdAt])
  @@index([studentId])
}

model Quiz {
  id              String           @id @default(uuid())
  lessonId        String?          @unique
  lesson          Lesson?          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  dailyExerciseId String?          @unique
  dailyExercise   DailyExercise?   @relation(fields: [dailyExerciseId], references: [id], onDelete: Cascade)
  examId          String?          @unique
  exam            Exam?            @relation(fields: [examId], references: [id], onDelete: Cascade)
  maxScore        Int              @default(20) // Graded out of 20
  aiGenerated     Boolean          @default(true)
  questions       Json             @default("[]")
  mistakes        StudentMistake[]
  createdAt       DateTime         @default(now())
}

model AccessCode {
  id          String    @id @default(uuid())
  code        String    @unique
  accessType  String // 'MONTHLY' or 'YEARLY'
  validMonths Int[]     @default([]) // Exact months this code unlocks (e.g. [9, 10] for Sept/Oct)
  validDays   Int? // Number of days valid from redemption
  isUsed      Boolean   @default(false)
  studentId   String? // Relation to the User/Student model
  user        User?     @relation(fields: [studentId], references: [id])
  subjectId   String
  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
}

model ParentStudentLink {
  id        String   @id @default(cuid())
  parentId  String
  studentId String
  parent    User     @relation("ParentLink", fields: [parentId], references: [id], onDelete: Cascade)
  student   User     @relation("StudentLink", fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([parentId, studentId])
}

model StudentFriendLink {
  id        String   @id @default(cuid())
  studentId String
  friendId  String
  student   User     @relation("StudentLinkSource", fields: [studentId], references: [id], onDelete: Cascade)
  friend    User     @relation("StudentLinkTarget", fields: [friendId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([studentId, friendId])
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String
  targetUrl String?
  month     Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudentMistake {
  id              String   @id @default(uuid())
  studentId       String // References the student's ID
  user            User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mistakeContent  String // The wrong answer or mistake description (الخطأ)
  correctSolution String // The correct answer or explanation (الحل)
  lessonId        String?
  lesson          Lesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  quizId          String
  quiz            Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@index([studentId, createdAt(sort: Desc)])
  @@index([quizId])
}

model Enrollment {
  id             String    @id @default(uuid())
  studentId      String
  student        User      @relation("StudentEnrollments", fields: [studentId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  enrolledMonths Int[]     @default([]) // Exact months unlocked
  validUntil     DateTime? // Expiration date if unlocked via time-based code
  createdAt      DateTime  @default(now())

  @@unique([studentId, subjectId])
}

model LiveClass {
  id        String   @id @default(uuid())
  title     String
  zoomLink  String
  month     Int
  date      DateTime
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model ChatSession {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model ChatMessage {
  id            String      @id @default(uuid())
  chatSessionId String
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  role          String // 'user' or 'assistant'
  content       String
  createdAt     DateTime    @default(now())
}

model DailyExercise {
  id                 String             @id @default(uuid())
  title              String
  a4ImageUrl         String
  maxScore           Int                @default(20)
  level              Level
  stream             Stream
  subjectId          String
  subject            Subject            @relation("PrimarySubject", fields: [subjectId], references: [id], onDelete: Cascade)
  secondarySubjectId String?
  secondarySubject   Subject?           @relation("SecondarySubject", fields: [secondarySubjectId], references: [id], onDelete: SetNull)
  month              Int
  quiz               Quiz?
  materials          ExerciseMaterial[]
  createdAt          DateTime           @default(now())
}

model ExerciseMaterial {
  id              String        @id @default(uuid())
  title           String
  fileUrl         String
  fileType        String?
  dailyExerciseId String
  dailyExercise   DailyExercise @relation(fields: [dailyExerciseId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
}

model Exam {
  id                 String              @id @default(uuid())
  title              String
  subjectId          String
  subject            Subject             @relation("ExamSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  secondarySubjectId String?
  secondarySubject   Subject?            @relation("ExamSecondarySubject", fields: [secondarySubjectId], references: [id])
  level              Level
  stream             Stream
  month              Int
  a4ImageUrl         String
  maxScore           Int                 @default(20)
  quiz               Quiz?
  materials          ExamMaterial[]
  submissions        StudentSubmission[]
  quizAttempts       QuizAttempt[]
  createdAt          DateTime            @default(now())
}

model ExamMaterial {
  id        String   @id @default(uuid())
  title     String
  fileUrl   String
  fileType  String?
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model StudentSubmission {
  id        String   @id @default(uuid())
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  imageUrl  String?
  fileUrl   String?
  fileType  String?
  score     Int?
  feedback  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examId, studentId])
}

model Notification {
  id         String   @id @default(cuid())
  title      String
  content    String
  levels     Level[]
  streams    Stream[]
  subjectIds String[]
  createdAt  DateTime @default(now())
}

model ReviewCard {
  id          String   @id @default(cuid())
  title       String
  question    String
  answer      String
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  level       Level
  stream      Stream
  month       Int
  exerciseRef String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ClassForum {
  id        String         @id @default(cuid())
  title     String
  subjectId String
  subject   Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  level     Level
  stream    Stream
  month     Int
  isOpen    Boolean        @default(true)
  messages  ForumMessage[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model ForumMessage {
  id        String     @id @default(cuid())
  forumId   String
  forum     ClassForum @relation(fields: [forumId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime   @default(now())
}

model ParentTicket {
  id         String   @id @default(cuid())
  parentId   String
  parent     User     @relation(fields: [parentId], references: [id], onDelete: Cascade)
  subject    String
  message    String
  adminReply String?
  status     String   @default("OPEN")
  createdAt  DateTime @default(now())
}

model PracticeAttempt {
  id              String              @id @default(cuid())
  studentId       String
  student         User                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  kind            PracticeKind
  subjectId       String?
  subject         Subject?            @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  month           Int?
  difficulty      PracticeDifficulty?
  score           Int
  maxScore        Int                 @default(20)
  correctCount    Int
  totalQuestions  Int
  durationSec     Int?
  challengeDay    String?
  reviewLessonIds String[]            @default([])
  createdAt       DateTime            @default(now())

  @@index([studentId, createdAt(sort: Desc)])
  @@index([studentId, subjectId, createdAt(sort: Desc)])
  @@index([studentId, kind, challengeDay])
  @@index([subjectId])
}

model SubscriptionRequest {
  id          String   @id @default(cuid())
  studentId   String
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectIds  String[]
  level       String
  stream      String
  wilaya      String
  baladiya    String?
  address     String
  phoneNumber String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
}

/// Profile namespace for Dalili SMART_TEACHER students
model DaliliProfile {
  id                 String         @id @default(cuid())
  userId             String         @unique
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// e.g. ابتدائي | متوسط | ثانوي
  educationPhase     String?
  /// e.g. أولى | ثانية | ثالثة | رابعة | خامسة | بكالوريا
  gradeLevel         String?
  /// High-school شعبة only e.g. علوم تجريبية | رياضيات
  branch             String?
  /// e.g. مبتدئ | متوسط | متقدم
  understandingLevel String?
  studySchedule      StudySchedule?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([educationPhase, gradeLevel])
}

/// Saved weekly AI study plan for a Dalili student
model StudySchedule {
  id              String        @id @default(cuid())
  daliliProfileId String        @unique
  daliliProfile   DaliliProfile @relation(fields: [daliliProfileId], references: [id], onDelete: Cascade)
  /// Structured weekly plan: { days: [{ day, tasks: [{ id, subject, time, duration, completed }] }] }
  plan            Json
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([daliliProfileId])
}

/// Pre-seeded / lazy-generated academy flashcard bank
model Flashcard {
  id          String   @id @default(cuid())
  subjectId   String
  lessonId    String?
  gradeLevel  String
  stream      String
  lessonTitle String
  frontText   String
  backText    String
  createdAt   DateTime @default(now())

  @@index([lessonId, gradeLevel, stream])
  @@index([gradeLevel, stream, lessonTitle])
  @@index([subjectId, gradeLevel, stream])
}

/// Pre-seeded / lazy-generated academy MCQ bank (distinct from image DailyExercise)
model QuestExercise {
  id            String   @id @default(cuid())
  subjectId     String
  lessonId      String?
  gradeLevel    String
  stream        String
  lessonTitle   String
  question      String
  options       String[]
  correctAnswer String
  explanation   String
  createdAt     DateTime @default(now())

  @@index([lessonId, gradeLevel, stream])
  @@index([gradeLevel, stream, lessonTitle])
  @@index([subjectId, gradeLevel, stream])
  @@map("DaliliDailyExercise")
}

/// Exact video watch duration per student/lesson (seconds, cumulative)
model WatchHistory {
  id             String   @id @default(cuid())
  studentId      String
  student        User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId       String
  lesson         Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  watchedSeconds Int      @default(0)
  lastWatchedAt  DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([studentId, lessonId])
  @@index([studentId, lastWatchedAt(sort: Desc)])
  @@index([subjectId])
}

/// Lesson completion progress within enrolled courses
model CourseProgress {
  id          String   @id @default(cuid())
  studentId   String
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  completed   Boolean  @default(true)
  completedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([studentId, lessonId])
  @@index([studentId, subjectId])
  @@index([studentId, completedAt(sort: Desc)])
}

/// Official exam / quiz attempts for LMS analytics (separate from AI companion PracticeAttempt)
model QuizAttempt {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examId    String?
  exam      Exam?    @relation(fields: [examId], references: [id], onDelete: SetNull)
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  score     Int
  maxScore  Int      @default(20)
  createdAt DateTime @default(now())

  @@index([studentId, createdAt(sort: Desc)])
  @@index([examId])
  @@index([subjectId])
}

/// Weekly recurring Zoom live schedule (template rows, not dated instances)
model LiveSession {
  id        String   @id @default(cuid())
  subject   String
  level     String
  dayOfWeek String
  startTime String
  endTime   String
  zoomLink  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([level, dayOfWeek])
  @@index([dayOfWeek, startTime])
}
